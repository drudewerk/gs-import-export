[
    {
        "name": "single object",
        "document": {
            "id": 1,
            "name": "Ada"
        },
        "expectedValues": [
            [
                "id",
                "name"
            ],
            [
                1,
                "Ada"
            ]
        ]
    },
    {
        "name": "nested objects arrays and nulls",
        "document": [
            {
                "profile": {
                    "name": "Ada",
                    "address": {
                        "city": "London"
                    }
                },
                "tags": [
                    "math",
                    "code"
                ],
                "contacts": [
                    {
                        "type": "email",
                        "value": null
                    }
                ]
            }
        ],
        "expectedValues": [
            [
                "profile.name",
                "profile.address.city",
                "tags.0",
                "tags.1",
                "contacts.0.type",
                "contacts.0.value"
            ],
            [
                "Ada",
                "London",
                "math",
                "code",
                "email",
                null
            ]
        ]
    }
]
